{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trentbest.github.io/TheSingularityWorkshop.SingularityCity/schemas/city-blueprint.schema.json",
  "title": "Singularity City Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cityId",
    "coordinateSpace",
    "generation",
    "districts",
    "routes"
  ],
  "properties": {
    "schema": {
      "const": "singularity-city.blueprint.v1"
    },
    "cityId": {
      "type": "string",
      "minLength": 1
    },
    "coordinateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "units"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "units": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "seed"
      ],
      "properties": {
        "algorithm": {
          "const": "grid-parcels.v1"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "districts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "className",
          "polygon",
          "parcelGrid"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "className": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "polygon": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "parcelGrid": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin",
              "columns",
              "rows",
              "width",
              "height",
              "gap",
              "occupancy"
            ],
            "properties": {
              "origin": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "columns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "gap": {
                "type": "number",
                "minimum": 0
              },
              "occupancy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "arterial",
              "transit",
              "local"
            ]
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  }
}
