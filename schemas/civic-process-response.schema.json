{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trentbest.github.io/TheSingularityWorkshop.SingularityCity/schemas/civic-process-response.schema.json",
  "title": "Singularity City Civic Process Response",
  "description": "Versioned, host-neutral shape for a civic process response. It records deliberation, proposals, a scoped decision, oversight, qualitative impacts and observable institutional signals. It does not grant execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "status",
    "hearingEventId",
    "proposals",
    "hearingDecision",
    "oversightObligations",
    "residentImpacts",
    "institutionalTrust"
  ],
  "properties": {
    "schema": {
      "const": "singularity-city.civic-process-response.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "hearingEventId": {
      "type": "string",
      "minLength": 1
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/proposal"
      }
    },
    "hearingDecision": {
      "$ref": "#/$defs/decision"
    },
    "oversightObligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/oversight"
      }
    },
    "residentImpacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/impact"
      }
    },
    "institutionalTrust": {
      "$ref": "#/$defs/trust"
    }
  },
  "$defs": {
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "civicPurpose",
        "resourceRequirements",
        "authorization"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "civicPurpose": {
          "type": "string",
          "minLength": 1
        },
        "resourceRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "description",
              "authority"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "authority": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "authorization": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authorityId",
        "sourceEventId",
        "outcome",
        "selectedProposalIds",
        "authorizations",
        "notAuthorized"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "authorityId": {
          "type": "string",
          "minLength": 1
        },
        "sourceEventId": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "selectedProposalIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authorizations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notAuthorized": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "oversight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "responsibleActorId",
        "trigger",
        "obligation",
        "evidenceExpected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "responsibleActorId": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "obligation": {
          "type": "string",
          "minLength": 1
        },
        "evidenceExpected": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "affectedGroup",
        "concern",
        "assessment",
        "followUp"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "affectedGroup": {
          "type": "string",
          "minLength": 1
        },
        "concern": {
          "type": "string",
          "minLength": 1
        },
        "assessment": {
          "type": "string",
          "minLength": 1
        },
        "followUp": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institutionId",
        "modelStatus",
        "dimensions",
        "noAggregateScore",
        "noAutomaticTrustGain",
        "limitations"
      ],
      "properties": {
        "institutionId": {
          "type": "string",
          "minLength": 1
        },
        "modelStatus": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "dimension",
              "expectedSignal",
              "evidenceRequired"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "expectedSignal": {
                "type": "string",
                "minLength": 1
              },
              "evidenceRequired": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "noAggregateScore": {
          "const": true
        },
        "noAutomaticTrustGain": {
          "const": true
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
