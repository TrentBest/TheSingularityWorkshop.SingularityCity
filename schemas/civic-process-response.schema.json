{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trentbest.github.io/TheSingularityWorkshop.SingularityCity/schemas/civic-process-response.schema.json",
  "title": "Singularity City Civic Process Response",
  "description": "Versioned, host-neutral shape for a civic process response. It records deliberation, proposals, a scoped decision, oversight, qualitative impacts and observable institutional signals. It does not grant execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "status",
    "hearingEventId",
    "proposals",
    "authorizations",
    "executionEvidence",
    "outcomeReviews",
    "hearingDecision",
    "oversightObligations",
    "residentImpacts",
    "institutionalTrust"
  ],
  "properties": {
    "schema": {
      "const": "singularity-city.civic-process-response.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "hearingEventId": {
      "type": "string",
      "minLength": 1
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/proposal"
      }
    },
    "hearingDecision": {
      "$ref": "#/$defs/decision"
    },
    "oversightObligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/oversight"
      }
    },
    "residentImpacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/impact"
      }
    },
    "institutionalTrust": {
      "$ref": "#/$defs/trust"
    },
    "authorizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authorization"
      }
    },
    "executionEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/executionEvidence"
      }
    },
    "outcomeReviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outcomeReview"
      }
    }
  },
  "$defs": {
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "civicPurpose",
        "resourceRequirements",
        "authorization"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "civicPurpose": {
          "type": "string",
          "minLength": 1
        },
        "resourceRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "description",
              "authority"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "authority": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "authorization": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authorityId",
        "sourceEventId",
        "outcome",
        "selectedProposalIds",
        "authorizations",
        "notAuthorized",
        "permittedActions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "authorityId": {
          "type": "string",
          "minLength": 1
        },
        "sourceEventId": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "selectedProposalIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authorizations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notAuthorized": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "permittedActions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "oversight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "responsibleActorId",
        "trigger",
        "obligation",
        "evidenceExpected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "responsibleActorId": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "obligation": {
          "type": "string",
          "minLength": 1
        },
        "evidenceExpected": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "affectedGroup",
        "concern",
        "assessment",
        "followUp"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "affectedGroup": {
          "type": "string",
          "minLength": 1
        },
        "concern": {
          "type": "string",
          "minLength": 1
        },
        "assessment": {
          "type": "string",
          "minLength": 1
        },
        "followUp": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institutionId",
        "modelStatus",
        "dimensions",
        "noAggregateScore",
        "noAutomaticTrustGain",
        "limitations"
      ],
      "properties": {
        "institutionId": {
          "type": "string",
          "minLength": 1
        },
        "modelStatus": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "dimension",
              "expectedSignal",
              "evidenceRequired"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "expectedSignal": {
                "type": "string",
                "minLength": 1
              },
              "evidenceRequired": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "noAggregateScore": {
          "const": true
        },
        "noAutomaticTrustGain": {
          "const": true
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceDecisionId",
        "proposalId",
        "grantingAuthorityId",
        "jurisdiction",
        "action",
        "subjectId",
        "scope",
        "exclusions",
        "prerequisiteEvidenceIds",
        "conditions",
        "executorId",
        "validFrom",
        "expiresAt",
        "status",
        "requiredExecutionEvidence",
        "reviewPath"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceDecisionId": {
          "type": "string",
          "minLength": 1
        },
        "grantingAuthorityId": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prerequisiteEvidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "executorId": {
          "type": "string",
          "minLength": 1
        },
        "validFrom": {
          "type": "string",
          "minLength": 1
        },
        "expiresAt": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "granted",
            "suspended",
            "revoked",
            "expired",
            "denied"
          ]
        },
        "requiredExecutionEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewPath": {
          "type": "string",
          "minLength": 1
        },
        "revocationReference": {
          "type": "string"
        },
        "proposalId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "executionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authorizationId",
        "proposalId",
        "action",
        "subjectId",
        "executorId",
        "occurredAt",
        "status",
        "evidence",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "authorizationId": {
          "type": "string",
          "minLength": 1
        },
        "proposalId": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "executorId": {
          "type": "string",
          "minLength": 1
        },
        "occurredAt": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "partial",
            "failed",
            "aborted"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "source",
              "provenance"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outcomeReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "decisionId",
        "authorizationIds",
        "executionEvidenceIds",
        "reviewerId",
        "reviewedAt",
        "intendedOutcome",
        "observedOutcome",
        "disposition",
        "unresolvedImpacts",
        "followUp"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "decisionId": {
          "type": "string",
          "minLength": 1
        },
        "authorizationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "executionEvidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewerId": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1
        },
        "intendedOutcome": {
          "type": "string",
          "minLength": 1
        },
        "observedOutcome": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "enum": [
            "achieved",
            "partially-achieved",
            "not-achieved",
            "indeterminate"
          ]
        },
        "unresolvedImpacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "followUp": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
