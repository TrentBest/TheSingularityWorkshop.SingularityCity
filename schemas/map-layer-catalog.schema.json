{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesingularityworkshop.com/schemas/map-layer-catalog.schema.json",
  "title": "Singularity City Map Layer Catalog",
  "type": "object",
  "required": [
    "schema",
    "cityId",
    "coordinateSpace",
    "layers"
  ],
  "properties": {
    "schema": {
      "const": "singularity-city.map-layer-catalog.v1"
    },
    "cityId": {
      "type": "string"
    },
    "coordinateSpace": {
      "type": "string"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "source",
          "status",
          "defaultVisible",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "status": {
            "enum": [
              "synthetic-fixture",
              "synthetic-screening",
              "preview",
              "generated-preview",
              "observed",
              "authored",
              "simulated",
              "committed"
            ]
          },
          "defaultVisible": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
